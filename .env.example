# ==============================================================================
# EncryptPlus (ECDAT) Master Configuration (Hindsight Memory Only)
# ==============================================================================
# Instructions for setup:
# 1. Copy this file to .env (or run ./start.sh which will guide you)
# 2. Fill in your Hindsight API key below (https://hindsight.vectorize.io)
# 3. Run: python scripts/check_config.py
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DATABASE (MANDATORY FOR RUNNING ENCRYPTPLUS)
# ------------------------------------------------------------------------------
# APP_ENV: "development", "test", or "production"
APP_ENV=development

# Database connection URL:
# - SQLite (default for standalone local development): sqlite:///./ecdat.db
# - PostgreSQL (used in docker-compose): postgresql://ecdat:ecdatpassword@localhost:5432/ecdat
DATABASE_URL=sqlite:///./ecdat.db

# Frontend API Base URL (used by Next.js frontend to talk to FastAPI backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. HINDSIGHT PERSISTENT AI MEMORY (MANDATORY FOR CROSS-SESSION AGENT MEMORY)
# ------------------------------------------------------------------------------
# Set to 'false' to disable remote persistent memory (in-process fallback store used)
HINDSIGHT_ENABLED=true

# Hindsight API Key:
# Obtain your key from your Hindsight Cloud console:
# https://hindsight.vectorize.io (or your self-hosted deployment)
HINDSIGHT_API_KEY=

# Hindsight Base URL:
# Cloud endpoint or your self-hosted instance URL
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Memory Bank Identifier:
# Namespace identifier. EncryptPlus automatically isolates per-user
# banks using "{HINDSIGHT_BANK_ID}-{user_id}"
HINDSIGHT_BANK_ID=encryptplus-agent

# Hindsight request timeout in seconds (optional, default: 10.0)
HINDSIGHT_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 3. BACKGROUND WORKER & REDIS (OPTIONAL)
# ------------------------------------------------------------------------------
# Set to 'true' if running external Celery / Redis background workers.
# Default is 'false' (uses durable in-process background task tracking)
WORKER_ENABLED=false

# Redis URL (only required if WORKER_ENABLED=true)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (ENCRYPTPLUS MULTI-USER)
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens (JWT). If blank, a safe fallback is generated.
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
# Session expiration in hours (default: 24)
AUTH_SESSION_EXPIRY_HOURS=24
# Cookie name for storing session tokens
AUTH_COOKIE_NAME=ecdat_session

